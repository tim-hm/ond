# The image builds only the Rust workspace: keep the client apps, docs, and
# especially the multi-gigabyte target/ out of the build context.
target/
ios/
web/
docs/
infra/
.git/
.github/
.codegraph/

# Machine-local credentials must not enter an image layer or become readable by
# a dependency build script. Git ignores these independently; Docker does not
# consult .gitignore when assembling its context.
.env
.env.*
*.pem
*.key
*.p8
