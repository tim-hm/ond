# TLS termination and the only public entrance. Every hostname below must
# resolve before first boot, or ACME issuance fails and retries with backoff —
# one certificate per site block, so an unlanded record holds the whole set
# back. The hosts arrive as placeholders deploy:api renders from `tofu output`,
# so no literal here can disagree with its Route 53 record.

# Caddy 2.7 made HTTP metrics opt-in, and the failure without this block is the
# quiet kind: the endpoint answers, Prometheus records the target as up, and
# the exposition carries configuration metrics and not one request.
{
	servers {
		metrics
	}
}

# Caddy's own metrics: no host port publishes 2019, so only Prometheus on the
# compose network can connect. A site block rather than `admin :2019`, whose
# endpoint also accepts configuration writes — opening that to the network
# would let any container there rewrite the reverse proxy.
:2019 {
	metrics
}

# The API on its own name, so infra/main.tf's record can be repointed without
# moving the marketing page. Every path goes to the API, which is what makes
# the separate metrics port in crates/api structural — no allowlist here could
# keep a path on 18100 private. reverse_proxy appends the accepted peer to
# X-Forwarded-For, the key crates/api/src/throttle.rs rations against.
__API_HOST__ {
	reverse_proxy api:18100
}

__WEB_HOST__ {
	root * /srv/web

	encode zstd gzip

	# Extensionless URLs, because the app ships them as literals:
	# `LegalLinks.privacyPolicy` ends in `/privacy`, and App Review rejects a
	# paywall whose privacy link 404s. `file_server` alone resolves neither
	# `/privacy` nor `/support`.
	try_files {path} {path}.html {path}/index.html

	file_server
}
