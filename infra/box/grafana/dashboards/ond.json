{
  "uid": "ond-overview",
  "title": "önd",
  "tags": ["ond"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "annotations": {
    "list": [
      {
        "name": "Deploys",
        "enable": true,
        "iconColor": "purple",
        "datasource": {
          "type": "prometheus",
          "uid": "ond-prometheus"
        },
        "expr": "changes(ond_process_start_time_seconds[5m]) > 0",
        "titleFormat": "restarted",
        "step": "1m"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "People",
      "description": "Every identity that has ever opened the app: one is created on first launch, before any purchase and without anybody signing up.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "ond_users_total",
          "legendFormat": "people"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Paying",
      "description": "Live subscriptions, counted by the same rule the app enforces — defined once in features::entitlement, never in an exporter's SQL.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum(ond_active_subscriptions)",
          "legendFormat": "paying"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Gross MRR",
      "description": "Those subscriptions at US list price. Not money received: no tax, no Apple's cut, no currency.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "ond_gross_mrr_usd",
          "legendFormat": "mrr"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Targets down",
      "description": "Scrape targets not answering. Counted rather than compared against a total, so adding a target to prometheus.yml cannot leave this panel permanently wrong — which is what a hard-coded healthy count did.",
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "count(up == 0) or vector(0)",
          "legendFormat": "down"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Coach",
      "description": "Where a reply would come from right now. Live is evidence — only a real successful call sets it — so untried is not a fault and not a reassurance either.",
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "—",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "graphMode": "area"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "ond_assistant_mode == 1",
          "legendFormat": "{{mode}}"
        }
      ]
    },
    {
      "type": "table",
      "title": "Firing",
      "description": "The rules in infra/box/alerts.yml, read from Prometheus' own ALERTS series. They also reach an inbox through Alertmanager; this is so the dashboard does not have to be what finds out. Silences live in Alertmanager at 18106 — an email cannot acknowledge anything.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": false
          },
          "mappings": []
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "severity"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "critical": {
                        "color": "red",
                        "index": 0
                      },
                      "warning": {
                        "color": "orange",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "ALERTS{alertstate=\"firing\"}",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "alertstate": true
            },
            "indexByName": {
              "alertname": 0,
              "severity": 1,
              "job": 2
            }
          }
        }
      ]
    },
    {
      "type": "row",
      "title": "Traffic",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 14
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Calls by RPC",
      "description": "Native gRPC completions, read from the trailer rather than the HTTP status — a gRPC-Web failure is an HTTP 200 with a non-zero code out of band.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (method) (rate(ond_grpc_requests_total[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Failures by RPC",
      "description": "Excludes the statuses this API returns on purpose: unauthenticated before an identity settles, throttled, unentitled, malformed, and the two codes a disconnecting phone produces.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (method) (rate(ond_grpc_requests_total{status!~\"0|1|2|3|7|8|16\"}[5m]))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency p95 by RPC",
      "description": "The histogram carries the operation and the counter carries the outcome, so this cannot be split by status — deliberately. Note the 10s bucket ceiling: a streamed coach turn is measured by its own time-to-first-token panel instead.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(ond_grpc_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{method}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Outcomes",
      "description": "Numeric gRPC status codes. 0 ok, 3 invalid argument, 7 permission denied, 8 resource exhausted, 13 internal, 16 unauthenticated.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (status) (rate(ond_grpc_requests_total[5m]))",
          "legendFormat": "gRPC {{status}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (status) (rate(ond_requests_total[5m]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Coach",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Where answers come from",
      "description": "The panel this feature had no way to show. Every fallback path returns a successful RPC, so an outage is invisible in the traffic row above and visible only here.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum(rate(ond_assistant_answers_total{source=\"model\"}[15m]))",
          "legendFormat": "model"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum(rate(ond_assistant_answers_total{source=\"fallback\"}[15m]))",
          "legendFormat": "fallback"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Why it fell back",
      "description": "subscription_required and allowance_spent are the product working. Anything else is a fault, and provider_unavailable on a beta usually means the box cannot sign for Bedrock.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (reason) (rate(ond_assistant_fallbacks_total[15m]))",
          "legendFormat": "{{reason}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time to first token (p95)",
      "description": "How long somebody watches nothing before the coach starts writing. The transport histogram cannot answer this: for a server stream it stops at the response head, which is when the handler returned the stream.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(ond_assistant_time_to_first_token_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens",
      "description": "What the coach costs, per second, split the way Bedrock bills it. Cached reads are not a subset of prompt tokens — they are priced separately, so adding them would overstate the bill.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (kind) (rate(ond_assistant_tokens_total[1h]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Tokens today",
      "description": "The same counters read as a daily total, which is the number that turns into an invoice.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (kind) (increase(ond_assistant_tokens_total[24h]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Money",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Purchase verification",
      "description": "What became of each submitted App Store transaction. rejected is the one that matters: a sustained share of it means Apple-signed purchases are not being honoured, and every refusal is logged at debug, which production drops.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (outcome) (rate(ond_entitlement_verifications_total[1h]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Honoured by environment",
      "description": "A TestFlight build points at the production API and transacts in Sandbox, so both are honoured deliberately. This is what makes 'how many are real subscribers' answerable.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 49
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 25,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "sum by (environment) (increase(ond_entitlement_purchases_total[24h]))",
          "legendFormat": "{{environment}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "The box",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Disk free",
      "description": "Both volumes. The root disk fills with images a deploy left behind; the data disk holds Postgres, the 2 GiB TSDB and Grafana. A full data disk stops Postgres accepting writes while /health, which never touches it, keeps answering ok.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{fstype!~\"tmpfs|overlay\"}",
          "legendFormat": "{{mountpoint}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memory available",
      "description": "2 GiB total across every container, and no swap — what follows running out is the OOM killer picking a process, which will not be the one at fault. MemAvailable, not MemFree: Linux spends free memory on page cache by design.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "ond-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "ond-prometheus"
          },
          "expr": "node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes",
          "legendFormat": "available"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "CPU",
      "description": "Two Graviton vCPUs. Sustained saturation here is the signal to bump the instance type, which the memory panel usually reaches first.",
      "gridPos": {
