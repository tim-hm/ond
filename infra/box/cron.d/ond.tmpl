# The box's scheduled work, rendered and installed to /etc/cron.d/ond by
# `mise run deploy:api`. Installed by deploy rather than cloud-init, which runs
# only at first boot: an instance keeps the crontab it was born with, so a fix
# would reach a fresh box and no other. That drift is how the nightly dump
# pointed at the wrong database for eight days.

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin:/snap/bin
AWS_DEFAULT_REGION=__REGION__

# Output goes to the journal rather than /var/log, which journald rotates for
# free; read it with `journalctl -t ond-backup`. The pipe means cron sees
# logger's exit status, not the script's — which is fine, because backup.sh
# reports through ond_backup_success in the textfile collector and BackupStale
# reads that. The metric is the report; this is the transcript.
17 2 * * * root /usr/local/bin/backup.sh __BACKUP_BUCKET__ 2>&1 | logger -t ond-backup

# Five minutes against a CloudWatch alarm that treats missing data as breaching.
# Frequent enough that a dead monitoring stack is noticed inside a coffee break,
# infrequent enough to stay far inside the CloudWatch free tier.
*/5 * * * * root /usr/local/bin/heartbeat.sh __HEARTBEAT_NAMESPACE__ __HEARTBEAT_METRIC__ 2>&1 | logger -t ond-heartbeat
