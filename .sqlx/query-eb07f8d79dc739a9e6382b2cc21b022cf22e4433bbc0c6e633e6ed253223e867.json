  "query": "SELECT\n            p.technique_id,\n            p.stage_ordinal,\n            p.kind AS \"kind: PhaseKind\",\n            p.passage AS \"passage: Passage\",\n            p.duration_ms\n         FROM user_technique_phases p\n         JOIN user_techniques t ON t.id = p.technique_id\n         WHERE t.user_id = $1\n         ORDER BY p.technique_id, p.stage_ordinal, p.ordinal",
